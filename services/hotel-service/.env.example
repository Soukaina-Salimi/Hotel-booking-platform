# A copier en .env dans chaque service Laravel apres creation du projet
# (php artisan key:generate a lancer une fois le .env en place)

APP_NAME=HotelService
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hotel_db
DB_USERNAME=rh_app
DB_PASSWORD=rh_app_password


RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
